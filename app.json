{
  "expo": {
    "name": "Raízes",
    "slug": "raizes",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "raizes",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#12100e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.ulbra.raizes"
    },
    "android": {
      "package": "br.edu.ulbra.raizes",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#12100e"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Raízes — Turismo em Palmas",
      "shortName": "Raízes",
      "lang": "pt-BR",
      "description": "Descubra lugares, histórias e roteiros culturais de Palmas, Tocantins.",
      "themeColor": "#faf7f4",
      "backgroundColor": "#faf7f4",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      ["expo-splash-screen", { "backgroundColor": "#12100e", "resizeMode": "contain" }],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Raízes usa sua localização para mostrar lugares culturais próximos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/raizes-app"
    }
  }
}
